# Copy to .env and fill in. NEVER commit .env.  (chmod 600 .env on the server)
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# ---------- Security ----------
BACKEND_API_KEY=change-me-to-a-long-random-string-at-least-24-chars
DASHBOARD_PASSWORD=change-me
N8N_ENCRYPTION_KEY=change-me-another-long-random-string

# ---------- Database ----------
# Bundled Postgres container (default):
POSTGRES_USER=jobagent
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=jobagent
# Or Supabase: use the *Session pooler* connection string (IPv4-compatible), with the
# "postgresql+psycopg://" prefix, and remove the `db` service from docker-compose.yml:
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# ---------- AI ----------
LLM_PROVIDER=gemini            # gemini | openai | none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MAX_LLM_CALLS_PER_DAY=150      # hard cap; keyword scoring is used once reached

# ---------- Matching preferences ----------
MIN_MATCH_SCORE=60             # only jobs scoring >= this are emailed
MAX_EXPERIENCE_YEARS=2
JOB_MAX_AGE_DAYS=21

# ---------- Gmail API (see README "Gmail API setup") ----------
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
NOTIFY_EMAIL_TO=you@gmail.com
ADMIN_ALERTS_ENABLED=true
DRY_RUN_EMAIL=false            # true = log emails instead of sending (for testing)

# ---------- Optional keyed job APIs ----------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=

# ---------- Scheduling ----------
# n8n ticks every minute. Only enable this if you run WITHOUT n8n.
# Each source's own interval (2 min ATS, 5 min Workday, 1 min Gmail) is set in config/sources.yaml.
INTERNAL_SCHEDULER_ENABLED=false
CYCLE_INTERVAL_SECONDS=60
CYCLE_TIME_BUDGET_SECONDS=240
# Scores + emails new jobs as soon as they are found, independent of fetching.
PROCESSING_WORKER_ENABLED=true
# Free external dead-man's switch: create a check at https://healthchecks.io (period 5 min, grace 15 min)
HEALTHCHECKS_PING_URL=

# ---------- HTTP ----------
HTTP_USER_AGENT=ai-job-alert-agent/1.0 (personal, non-commercial job alert bot)
LOG_LEVEL=INFO

# ---------- Optional HTTPS proxy (docker compose --profile proxy up -d) ----------
DOMAIN=
ACME_EMAIL=
# When n8n is behind HTTPS set these:
# N8N_HOST=n8n.example.com
# N8N_PROTOCOL=https
# N8N_WEBHOOK_URL=https://n8n.example.com/
# N8N_SECURE_COOKIE=true
