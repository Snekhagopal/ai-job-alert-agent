{
  "id": "aiJobMonitor0001",
  "name": "AI Job Monitor",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "minutes", "minutesInterval": 1 }] }
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Every minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_URL }}/api/run-cycle?background=true",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "X-API-Key", "value": "={{ $env.BACKEND_API_KEY }}" }]
        },
        "options": {
          "timeout": 30000,
          "response": { "response": { "neverError": true, "fullResponse": true } }
        }
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000002",
      "name": "Run monitoring cycle",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "c0000000-0000-4000-8000-000000000001",
              "leftValue": "={{ $json.statusCode >= 500 || $json.statusCode == 401 }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000003",
      "name": "Backend error?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [480, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_URL }}/api/admin-alert",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "X-API-Key", "value": "={{ $env.BACKEND_API_KEY }}" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ subject: 'Monitoring cycle failed (HTTP ' + $json.statusCode + ')', body: 'n8n could not complete /api/run-cycle at ' + $now.toISO() + '.\\n\\nResponse: ' + JSON.stringify($json.body).slice(0, 2000) }) }}",
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000004",
      "name": "Alert: cycle failed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, -100],
      "retryOnFail": true,
      "maxTries": 2,
      "continueOnFail": true
    },
    {
      "parameters": {
        "rule": { "interval": [{ "field": "hours", "hoursInterval": 1 }] }
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000005",
      "name": "Every hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.BACKEND_URL }}/api/health/sources",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "X-API-Key", "value": "={{ $env.BACKEND_API_KEY }}" }]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000006",
      "name": "Check source health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 10000
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "c0000000-0000-4000-8000-000000000002",
              "leftValue": "={{ $json.alertable_unhealthy_count }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000007",
      "name": "Any source unhealthy?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_URL }}/api/admin-alert",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "X-API-Key", "value": "={{ $env.BACKEND_API_KEY }}" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ subject: $json.alertable_unhealthy_count + ' job source(s) unhealthy', body: $json.sources.filter(s => !s.healthy && s.availability !== 'temporarily unavailable').map(s => s.source + ': last success ' + (s.last_success_at || 'never') + ', failures ' + s.consecutive_failures + '\\n  ' + (s.last_error || '').slice(0, 300)).join('\\n\\n') }) }}",
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000008",
      "name": "Alert: unhealthy sources",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 200],
      "continueOnFail": true
    }
  ],
  "connections": {
    "Every minute": { "main": [[{ "node": "Run monitoring cycle", "type": "main", "index": 0 }]] },
    "Run monitoring cycle": { "main": [[{ "node": "Backend error?", "type": "main", "index": 0 }]] },
    "Backend error?": { "main": [[{ "node": "Alert: cycle failed", "type": "main", "index": 0 }], []] },
    "Every hour": { "main": [[{ "node": "Check source health", "type": "main", "index": 0 }]] },
    "Check source health": { "main": [[{ "node": "Any source unhealthy?", "type": "main", "index": 0 }]] },
    "Any source unhealthy?": { "main": [[{ "node": "Alert: unhealthy sources", "type": "main", "index": 0 }], []] }
  },
  "settings": { "executionOrder": "v1", "timezone": "Asia/Kolkata", "saveDataSuccessExecution": "none", "saveDataErrorExecution": "all" },
  "pinData": {},
  "tags": []
}
